#!/bin/bash
# Create the offline vendor tarball for hugo.
# Hugo 0.170 dropped the extended LibSass build, so this is go modules only.
# The archive is an uncompressed tar named .tar.gz, matching earlier vendor files.

set -euo pipefail

NAME=hugo
VERSION=0.170.1
VENDOR=vendor20261117.tar.gz
Source0="https://github.com/gohugoio/hugo/archive/v${VERSION}/${NAME}-${VERSION}.tar.gz"

cd "$(dirname "$0")"

if [ ! -f "${NAME}-${VERSION}.tar.gz" ]; then
	echo "${NAME}-${VERSION}.tar.gz does not exist. Downloading"
	curl -o "${NAME}-${VERSION}.tar.gz" -L "$Source0"
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

tar -xzf "${NAME}-${VERSION}.tar.gz" -C "$workdir"
(
	cd "${workdir}/${NAME}-${VERSION}"
	go mod vendor
)
# Uncompressed, despite the name. %setup accepts it and earlier vendors used tar cvf.
tar cvf "$VENDOR" -C "$workdir" "${NAME}-${VERSION}/vendor"
